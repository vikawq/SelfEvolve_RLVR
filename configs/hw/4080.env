# 硬件档位：RTX 4080 (16GB, Ada sm_89)
# 用法：source configs/hw/${HW:-4080}.env
# 说明：本文件是所有与显存相关的参数的唯一来源；换卡只改 HW。
# 有效 batch 不随档位变化，档位只影响梯度累积步数。

export HW=4080
export GPU_NAME="NVIDIA GeForce RTX 4080"
export GPU_MEM_GB=16
export GPU_ARCH="Ada (sm_89)"
export BF16_OK=1
export FP8_OK=1          # W9 的 FP8 rollout 实验用

# --- 档位参数（W1 冒烟实测后回写）---
# 实测记录（Qwen2.5-1.5B-Instruct + LoRA r32 + vLLM 0.24，BF16）：
#   - ROLLOUT_GPU_MEM=0.30：vLLM 可初始化（约 4.67GB 预算，权重 3.09GB）
#   - ROLLOUT_GPU_MEM=0.25：vLLM 初始化失败（No available memory for the cache blocks）
#   - fp32 参数（FSDP 默认 model_dtype）+ micro batch 2：merge 恢复权重时 OOM（差 892MB）；
#     降到 micro batch 1 也没有改善 —— 根因是 dtype，不是激活（见 docs/troubleshooting.md §3.8）
# 结论：0.30 是 vLLM 能起来的下限附近；显式 model_dtype=bf16 后，micro batch 保持文档初值 2
#       即可跑通（实测 actor 峰值 9.28 GiB allocated，仍有余量）。
export ROLLOUT_GPU_MEM=0.3      # vLLM gpu_memory_utilization
export PPO_MICRO_BS=2           # actor ppo_micro_batch_size_per_gpu
export LOGPROB_MICRO_BS=2       # rollout/ref log_prob_micro_batch_size_per_gpu
export MAX_PROMPT_LEN=512
export MAX_RESPONSE_LEN=512
export GRAD_CKPT=True

# --- 固定项 ---
export N_GPUS=1
export ROLLOUT_TP=1
