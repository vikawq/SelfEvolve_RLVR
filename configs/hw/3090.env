# 硬件档位：RTX 3090 (24GB, Ampere sm_86)
# 用法：source configs/hw/${HW:-3090}.env
# 状态：**未实测**。3090 到位后跑 EXP-W01-02-smoke-3090，再用实测值回写。
# 差异：Ampere 不支持 FP8，W9 的 FP8 rollout 实验只能在 4080 / 云端做。

export HW=3090
export GPU_NAME="NVIDIA GeForce RTX 3090"
export GPU_MEM_GB=24
export GPU_ARCH="Ampere (sm_86)"
export BF16_OK=1
export FP8_OK=0

# --- 档位参数（文档初值，待实测校正）---
export ROLLOUT_GPU_MEM=0.4
export PPO_MICRO_BS=4
export LOGPROB_MICRO_BS=4
export MAX_PROMPT_LEN=512
export MAX_RESPONSE_LEN=1024
export GRAD_CKPT=True

# --- W2 baseline / profiling：长响应档位（**未实测**，3090 到位后回写）---
export PPO_MICRO_BS_LONG=2
export LOGPROB_MICRO_BS_LONG=2

# --- 固定项 ---
export N_GPUS=1
export ROLLOUT_TP=1
